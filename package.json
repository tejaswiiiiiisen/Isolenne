{
  "name": "skillorapath-workspace",
  "version": "1.0.0",
  "private": true,
  "description": "SkilloraPath Enterprise Application (Frontend & Backend)",
  "workspaces": [
    "frontend",
    "backend"
  ],
  "scripts": {
    "dev": "npm --prefix frontend run dev",
    "dev:frontend": "npm --prefix frontend run dev",
